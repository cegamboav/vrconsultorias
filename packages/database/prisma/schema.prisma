generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  FOLLOW_UP
  CLOSED_SUCCESS
  CLOSED_LOST
}

model User {
  id         String     @id @default(cuid())
  name       String
  email      String     @unique
  phone      String?
  password   String
  role       Role       @default(USER)
  /// Si el usuario está activo. Inactivos no pueden iniciar sesión ni usar la API.
  isActive   Boolean    @default(true)
  calendly   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]
  auditLogs  AuditLog[]
  leads      Lead[]     @relation("LeadOwner")
}

/// Registro de acciones administrativas y de configuración (sin depender de un lead).
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/// Línea de negocio / servicio principal del lead (multiservicio).
model ServiceCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Color hex para badges (ej. #6B9BD1).
  color     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  leads     Lead[]
}

model Lead {
  id                 String          @id @default(cuid())
  leadNumber         Int             @unique @default(autoincrement())
  ownerId            String?
  owner              User?           @relation("LeadOwner", fields: [ownerId], references: [id])
  serviceCategoryId  String
  serviceCategory    ServiceCategory   @relation(fields: [serviceCategoryId], references: [id])
  fullName           String
  /// Identificador principal de negocio: un solo lead por teléfono (dedup + timeline unificado).
  phone              String          @unique
  email              String?
  source             LeadSource
  /// Texto libre si el referidor no está registrado como lead.
  referredBy         String?
  /// Lead existente que refiere (cliente referidor).
  referredByLeadId   String?
  referredByLead     Lead?           @relation("LeadReferrals", fields: [referredByLeadId], references: [id])
  referredLeads      Lead[]          @relation("LeadReferrals")
  status             LeadStatus      @default(NEW)
  /// Motivo cuando el lead cierra como no concretado.
  noInvestmentReason String?
  /// Motivo por el que el lead está en pausa de seguimiento.
  followUpReason     FollowUpReason?
  /// Veces que el lead ha entrado al estado FOLLOW_UP (se incrementa solo al transicionar a FOLLOW_UP).
  followUpCount      Int             @default(0)
  nextActionDate     DateTime?
  lastActivityAt     DateTime?
  closedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  observations       String?
  activities         Activity[]

  @@index([referredByLeadId])
  @@index([serviceCategoryId])
}

enum LeadSource {
  REFERIDO
  DIRECTO
  PAGINA_WEB
  REDES_SOCIALES
  OTRO
}

enum FollowUpReason {
  NO_RESPONSE
  NO_MONEY
  CALL_LATER
  THINKING
  BUSY
  OTHER
}

model Activity {
  id          String       @id @default(cuid())
  leadId      String
  userId      String?
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now())
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([type])
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  WHATSAPP_SENT
  WHATSAPP_RECEIVED
  REMINDER_CREATED
  MEETING_SCHEDULED
  LEAD_REACTIVATED
  LEAD_CLOSED
}
