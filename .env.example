NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super-secret-change-this
JWT_EXPIRES_IN=7d

# Docker / PostgreSQL
POSTGRES_DB=crm_referidos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@crmreferidos.local
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_referidos?schema=public

# Frontend
VITE_API_URL=http://localhost:4000

# WhatsApp — pendiente de credenciales del cliente
# WHATSAPP_PROVIDER=noop                        # 'noop' (default) | 'meta'
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TOKEN=                               # Meta permanent token
# WHATSAPP_PHONE_NUMBER_ID=                     # Meta phone number ID
# WHATSAPP_BUSINESS_ACCOUNT_ID=                 # Meta business account ID
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=                # Webhook verification token

# Follow-up agent — pendiente de credenciales del cliente
# FOLLOW_UP_AGENT_ENABLED=false                 # 'true' to activate the scheduled agent
# FOLLOW_UP_AGENT_CRON=0 9 * * *               # Cron schedule (default: 9 AM daily)
# FOLLOW_UP_AGENT_TZ=America/Costa_Rica         # Timezone for the cron job
# FOLLOW_UP_AGENT_DRY_RUN=false  # Descomentar y poner 'false' para habilitar envíos reales (por defecto: true = solo simulación)
# FOLLOW_UP_AGENT_BATCH_SIZE=50                 # Max leads per run
# FOLLOW_UP_AGENT_MODE=rule-based               # 'rule-based' | 'claude' | 'both'

# Claude / Anthropic — required when FOLLOW_UP_AGENT_MODE=claude or both
# ANTHROPIC_API_KEY=                            # Anthropic API key (sk-ant-...)
# CLAUDE_AGENT_MODEL=claude-sonnet-4-5          # Model ID (default: null — must be set explicitly)
