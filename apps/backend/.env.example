# Copia a .env y ajusta valores. La API no arranca sin JWT_SECRET válido.

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Obligatorio: mín. 16 caracteres en dev, 32 en producción (NODE_ENV=production)
JWT_SECRET=genera_una_cadena_aleatoria_larga_aqui_min_32_chars

# Opcional (default 7d). Ejemplos: 7d, 24h, 3600
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/crm_referidos
